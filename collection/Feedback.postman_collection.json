              }
            },
            "url": {
              "raw": "{{base_url}}/relatorio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "relatorio"
              ]
            },
            "description": "Gera relatório sob demanda dos últimos 30 dias filtrado por urgência ALTA. Requer a Admin API Key no header x-api-key."
          },
          "response": []
