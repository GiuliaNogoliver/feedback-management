{
  "info": {
    "_postman_id": "f42b5d73-3422-4574-a997-956db06ae20a",
    "name": "Feedback Platform API",
    "description": "Postman Collection para a Plataforma Serverless de Gestão de Feedbacks.\n\nContém requisições com autenticação por API Key (x-api-key) para envio de avaliações e geração de relatórios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Avaliações",
      "item": [
        {
          "name": "CRITICA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{student_api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"descricao\": \"Péssimo atendimento. O sistema demorou muito para responder e deu erro.\",\n    \"nota\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/avaliacao",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "avaliacao"
              ]
            },
            "description": "Envia um feedback com nota crítica (<= 4). Requer a Student API Key no header x-api-key."
          },
          "response": []
        },
        {
          "name": "MEDIA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{student_api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"descricao\": \"O serviço é razoável, atendeu a necessidade mas a interface poderia ser mais rápida.\",\n    \"nota\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/avaliacao",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "avaliacao"
              ]
            },
            "description": "Envia um feedback com nota média (5 a 7). Requer a Student API Key no header x-api-key."
          },
          "response": []
        },
        {
          "name": "BOA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{student_api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"descricao\": \"Excelente plataforma! O atendimento foi super rápido e muito intuitivo.\",\n    \"nota\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/avaliacao",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "avaliacao"
              ]
            },
            "description": "Envia um feedback com nota alta (>= 8). Requer a Student API Key no header x-api-key."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Relatórios",
      "item": [
        {
          "name": "GERAR RELATORIO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{admin_api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 7,\n  \"urgencia\": \"ALL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/relatorio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "relatorio"
              ]
            },
            "description": "Gera relatório sob demanda dos últimos 7 dias (todas as urgências). Requer a Admin API Key no header x-api-key."
          },
          "response": []
        },
        {
