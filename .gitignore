# ==========================================
# Python Ignore Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging / build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage / linting reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# AWS Lambda / Serverless build artifacts
package/
*.zip
.aws-sam/

# ==========================================
# Terraform Ignore Rules
# ==========================================

# Local .terraform directories
**/.terraform/

# .tfstate files (contains sensitive state data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files (may contain sensitive variables/passwords)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ==========================================
# General & Environment Ignores
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
